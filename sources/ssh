#!/usr/bin/env python3
"""hypertop source: every host in ~/.ssh/config.

Nothing has to be installed on the hosts. Each one gets a small sampler that runs
for as long as hypertop does, over one ssh connection, using what the machine
already has: /proc on Linux, the usual commands on macOS, PowerShell on Windows.
One running sampler costs far less than a new connection and a new interpreter
every few seconds, and it ends by itself when the connection goes.

Everything goes through ssh and its config, this machine included if it's listed, so
that an alias means here what it means everywhere else. Aliases listed in
~/.config/hypertop/ssh-skip (one per line) are left out.

While a machine is up it is asked for its MAC address, which is remembered in
~/.cache/hypertop/ssh-hosts.json, so that it can still be woken once it is off and
still shows what it is. `ssh --wake MAC` sends the magic packet.
"""
import base64
import glob
import ipaddress
import json
import os
import re
import shlex
import signal
import socket
import subprocess
import sys
import threading
import time

SKIP_FILE = os.path.expanduser("~/.config/hypertop/ssh-skip")
CONFIG = os.path.expanduser("~/.ssh/config")
RETRY = 30          # seconds between looks at a host that doesn't answer
SAMPLE = 5          # seconds between samples
CACHE = os.path.expanduser("~/.cache/hypertop/ssh-hosts.json")

BATCH = ["-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5"]
# For the one long connection a sampler keeps: notice quickly when it dies.
LONG = BATCH + ["-o", "ServerAliveInterval=5", "-o", "ServerAliveCountMax=2"]
# For peeks and actions: repeated short commands share one connection.
SHARED = BATCH + ["-o", "ControlMaster=auto", "-o", "ControlPath=~/.cache/hypertop/cm-%C", "-o", "ControlPersist=60"]

# What ssh says when it can't get to a machine at all, as opposed to getting there and
# being turned away, which is a problem to show rather than a machine that's off.
UNREACHABLE = re.compile(r"connection refused|timed out|no route to host|network is unreachable|host is down|could not resolve", re.I)

LINUX_SAMPLER = r"""
