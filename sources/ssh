WINDOWS_PS = "powershell -NoProfile -NonInteractive -Command "

lock = threading.Lock()


def emit(**fields):
    line = json.dumps(fields, ensure_ascii=False) + "\n"
    with lock:
        try:
            sys.stdout.write(line)
            sys.stdout.flush()
        except OSError:
            leave()


def leave(*_):
    try:
        os.killpg(0, signal.SIGTERM)
    finally:
        os._exit(0)


def magic_packet(mac):
    """The Wake-on-LAN packet: six 0xff bytes, then the address sixteen times."""
    digits = re.sub(r"[^0-9a-fA-F]", "", mac)
    if len(digits) != 12:
        raise ValueError(f"not a MAC address: {mac}")
    return b"\xff" * 6 + bytes.fromhex(digits) * 16


def usable_mac(text):
    """A real address, normalised, or None. An all-zero or 02:00:00:00:00:00 address is
    what a system shows instead of the real one: a wake packet to it would do nothing."""
    mac = text.replace("-", ":").lower()
    return None if mac in ("00:00:00:00:00:00", "02:00:00:00:00:00") else mac


def wake(mac):
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        sock.sendto(magic_packet(mac), ("255.255.255.255", 9))
    print(f"magic packet sent to {mac}")


def is_local_network(hostname):
    """Whether a magic packet could reach it: a private address or a .local name."""
    if hostname.endswith(".local"):
        return True
    try:
        return ipaddress.ip_address(hostname).is_private
    except ValueError:
        return False


remembered_lock = threading.Lock()


def load_remembered():
    try:
        with open(CACHE) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def remember(alias, **fields):
    with remembered_lock:
        known = load_remembered()
        entry = known.setdefault(alias, {})
        if all(entry.get(k) == v for k, v in fields.items()):
            return
        entry.update(fields)
        partial = CACHE + ".tmp"
        with open(partial, "w") as fh:
            json.dump(known, fh)
        os.replace(partial, CACHE)


def read_hosts(path, seen=None):
    """The Host blocks of an ssh config: each one's aliases, Includes followed."""
    seen = set() if seen is None else seen
    path = os.path.expanduser(path)
    if path in seen or not os.path.isfile(path):
        return []
    seen.add(path)
    blocks = []
    with open(path, errors="replace") as fh:
        for raw in fh:
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.replace("=", " ", 1).split(None, 1)
            key = parts[0].lower()
            value = parts[1] if len(parts) > 1 else ""
            if key == "host":
                blocks.append([a for a in value.split() if not set(a) & set("*?!")])
            elif key == "include":
                for pattern in value.split():
                    pattern = os.path.expanduser(pattern)
                    if not os.path.isabs(pattern):
                        pattern = os.path.join(os.path.dirname(CONFIG), pattern)
                    for included in sorted(glob.glob(pattern)):
                        blocks.extend(read_hosts(included, seen))
    return [b for b in blocks if b]


def read_skip():
    try:
        with open(SKIP_FILE) as fh:
            return {line.split("#")[0].strip() for line in fh} - {""}
    except OSError:
        return set()


def ssh_settings(alias):
    r = subprocess.run(["ssh", "-G", alias], capture_output=True, text=True, stdin=subprocess.DEVNULL)
    found = {}
    for line in r.stdout.splitlines():
        key, _, value = line.partition(" ")
        found.setdefault(key, value)
    return found.get("hostname", alias), int(found.get("port", 22)), found.get("user", "")


class Host:
    def __init__(self, aliases):
        self.alias = aliases[0]
        self.aliases = aliases
        self.hostname, self.port, self.user = ssh_settings(self.alias)
        self.system = None

    def argv(self, options, command):
        return ["ssh", *options, self.alias, command]

    def ask(self, command, timeout=12):
        return subprocess.run(self.argv(BATCH, command), capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL, errors="replace")

    def detect(self):
        """Which system this is. cmd.exe expands %OS%, and nothing else does."""
        r = self.ask("echo %OS%; uname -s")
        if r.returncode == 255 or (r.returncode != 0 and not r.stdout.strip()):
            raise OSError((r.stderr.strip().splitlines() or ["ssh failed"])[-1])
        if "Windows_NT" in r.stdout:
            self.system = "Windows"
        else:
            words = r.stdout.split()
            self.system = {"Darwin": "macOS"}.get(words[-1], words[-1]) if words else "unknown"

    def version(self):
        command = {
            "Linux": "sed -n 's/^PRETTY_NAME=//p' /etc/os-release",
            "macOS": "sw_vers -productVersion",
            "Windows": "ver",
        }.get(self.system)
        if not command:
            return ""
        lines = [line.strip().strip('"') for line in self.ask(command).stdout.splitlines() if line.strip()]
        text = lines[0] if lines else ""
        if self.system == "Windows":
            match = re.search(r"Version (\d+\.\d+\.\d+)", text)
            return f"Windows {match.group(1)}" if match else text
        return f"macOS {text}" if self.system == "macOS" and text else text

    def mac_address(self):
        """The address of the interface this machine reaches the network through."""
        unix = {
            "Linux": "i=$(ip route show default 2>/dev/null | awk '{print $5; exit}'); cat /sys/class/net/$i/address",
            # networksetup: ifconfig can show a placeholder instead of the real address.
            "macOS": "i=$(route -n get default 2>/dev/null | awk '/interface:/{print $2}'); networksetup -getmacaddress $i",
        }.get(self.system)
        if unix:
            command = "sh -c " + shlex.quote(unix)
        elif self.system == "Windows":
            command = WINDOWS_PS + '"(Get-NetAdapter -InterfaceIndex (Get-NetRoute -DestinationPrefix 0.0.0.0/0 | Sort-Object RouteMetric | Select-Object -First 1).ifIndex).MacAddress"'
        else:
            return None
        found = re.search(r"([0-9a-fA-F]{2}[:-]){5}[0-9a-fA-F]{2}", self.ask(command).stdout)
        return usable_mac(found.group(0)) if found else None

    def has(self, tool):
        probe = f"where {tool}" if self.system == "Windows" else f"command -v {tool}"
        return self.ask(probe).returncode == 0

    def peek_command(self, command):
        return self.argv(SHARED, command)

    def peeks(self):
        def unix(command):
            return self.peek_command("sh -c " + shlex.quote(command))

        def windows(script):
            return self.peek_command(WINDOWS_PS + '"' + script + '"')

        if self.system == "Linux":
            found = [
                ("processes", unix("ps -eo pcpu,pmem,comm --sort=-pcpu 2>/dev/null | head -24 || top -bn1 | head -24"), 3),
                ("disks", unix("df -h -x tmpfs -x devtmpfs -x squashfs -x overlay 2>/dev/null || df -h"), 15),
                ("network", unix("ip -br addr 2>/dev/null || ifconfig"), 15),
                ("failed", unix("systemctl --failed --no-pager --no-legend 2>&1; systemctl --user --failed --no-pager --no-legend 2>&1"), 15),
                ("warnings", unix("journalctl -p warning -n 40 --no-pager 2>/dev/null"), 15),
            ]
            if self.has("nvidia-smi"):
                found.insert(1, ("gpu", unix("nvidia-smi"), 5))
        elif self.system == "macOS":
            found = [
                # Not ps: on macOS its %CPU is a lifetime average, not what is busy now.
                ("processes", unix("top -l 2 -s 1 -n 22 -o cpu -stats pid,cpu,mem,command | awk '/^PID/{n++} n==2' | cut -c1-90"), 5),
                ("disks", unix("df -h | grep -vE '^(map|devfs)'"), 15),
                ("network", unix("ifconfig | grep -E '^[a-z]|inet ' | grep -B1 'inet ' | grep -v '^--'"), 15),
            ]
        elif self.system == "Windows":
            found = [
                ("processes", windows("Get-Process | Sort-Object CPU -Descending | Select-Object -First 22 Name,Id,SI,@{n='CPU s';e={[int]$_.CPU}},@{n='MB';e={[int]($_.WS/1MB)}} | Format-Table -AutoSize | Out-String -Width 110"), 5),
                ("disks", windows("Get-PSDrive -PSProvider FileSystem | Select-Object Name,@{n='Used GB';e={[int]($_.Used/1GB)}},@{n='Free GB';e={[int]($_.Free/1GB)}},Root | Format-Table -AutoSize | Out-String -Width 110"), 15),
                ("network", self.peek_command("ipconfig"), 15),
            ]
            if self.has("nvidia-smi"):
                found.insert(1, ("gpu", self.peek_command("nvidia-smi"), 5))
        else:
            found = [("uptime", unix("uptime; df -h 2>/dev/null | head -12"), 10)]
        return [{"label": label, "run": run, "every": every} for label, run, every in found]

    def actions(self):
        found = [
            {"id": "shell", "label": "Open a shell", "run": ["ssh", self.alias], "tty": True},
            {"id": "run", "label": "Run a command", "run": self.argv(SHARED, "{input}"), "input": "Command"},
        ]
        power = {
            "Linux": [("reboot", "Reboot", "sudo -n reboot"), ("poweroff", "Power off", "sudo -n poweroff"), ("suspend", "Suspend", "systemctl suspend")],
            "macOS": [("reboot", "Reboot", "sudo -n shutdown -r now"), ("poweroff", "Power off", "sudo -n shutdown -h now"), ("suspend", "Sleep", "pmset sleepnow")],
            "Windows": [("reboot", "Reboot", "shutdown /r /t 5"), ("poweroff", "Power off", "shutdown /s /t 5")],
        }.get(self.system, [])
        for action, label, command in power:
            found.append({"id": action, "label": label, "run": self.peek_command(command), "confirm": True})
        return found

    def actions_while_off(self, mac):
        found = [{"id": "shell", "label": "Open a shell", "run": ["ssh", self.alias], "tty": True}]
        if mac and is_local_network(self.hostname):
            found.insert(0, {"id": "wake", "label": "Wake (magic packet)",
                             "run": [sys.executable, os.path.abspath(__file__), "--wake", mac]})
        return found

    def info(self):
        address = self.hostname if self.port == 22 else f"{self.hostname}:{self.port}"
        info = {"address": address}
        if self.user:
            info["user"] = self.user
        if len(self.aliases) > 1:
            info["also"] = " ".join(self.aliases[1:])
        return info

    def sampler(self):
        script = {"Linux": LINUX_SAMPLER, "macOS": MAC_SAMPLER, "Windows": WINDOWS_SAMPLER}.get(self.system)
        if script is None:
            return None, None
        script = script.replace("INTERVAL", str(SAMPLE)).replace("TEMPERATURE_CODE", MAC_TEMPERATURE)
        if self.system == "Windows":
            encoded = base64.b64encode(script.encode("utf-16-le")).decode()
            return self.argv(LONG, "powershell -NoProfile -NonInteractive -EncodedCommand " + encoded), None
        return self.argv(LONG, "sh -s"), script

    def sample_until_gone(self):
        """Report what the sampler prints until the connection ends. Returns what went
        wrong, if anything did beyond the connection going, which is ordinary."""
        argv, script = self.sampler()
        if argv is None:
            emit(id=self.alias, state="up", alert=None, metrics={})
            time.sleep(RETRY)
            return None
        proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, errors="replace")
        last_error = []

        def read_errors():
            for line in proc.stderr:
                if line.strip():
                    last_error[:] = [line.strip()]

        threading.Thread(target=read_errors, daemon=True).start()
        if script:
            try:
                proc.stdin.write(script)
                proc.stdin.flush()
            except OSError:
                pass  # it has gone already, which its exit status will say
        samples = 0
        for line in proc.stdout:
            metrics = {}
            for word in line.split():
                key, _, value = word.partition("=")
                try:
                    metrics[key] = float(value)
                except ValueError:
                    pass
            if metrics:
                samples += 1
                emit(id=self.alias, state="up", alert=None, metrics=metrics)
        code = proc.wait()
        if samples and code in (0, 255):
            return None
        return "sampler: " + (last_error[0] if last_error else f"exit {code}")


def watch(host):
    known = load_remembered().get(host.alias, {})
    emit(id=host.alias, name=host.alias, group="computers", kind=known.get("system", "?"), state="unknown", info=host.info())
    was_off = False
    trouble = None
    while True:
        try:
            host.detect()
            version = host.version()
            remember(host.alias, system=host.system, version=version)
            mac = host.mac_address()
            if mac:
                remember(host.alias, mac=mac)
            # A sampler that keeps failing stays shown as failing, until a sample says otherwise.
            emit(id=host.alias, kind=host.system, note=version, state="unknown" if trouble else "up", alert=trouble,
                 peeks=host.peeks(), actions=host.actions())
        except (OSError, subprocess.SubprocessError) as exc:
            if UNREACHABLE.search(str(exc)):
                if not was_off:
                    known = load_remembered().get(host.alias, {})
                    emit(id=host.alias, state="down", alert=None, metrics={}, note=known.get("version", ""), peeks=[],
                         actions=host.actions_while_off(known.get("mac")))
                was_off = True
            else:
                was_off = False
                emit(id=host.alias, state="unknown", alert=f"ssh: {exc}", metrics={},
                     actions=[{"id": "shell", "label": "Open a shell", "run": ["ssh", host.alias], "tty": True}])
            trouble = None
            time.sleep(RETRY)
            continue
        was_off = False
        trouble = host.sample_until_gone()
        if trouble:
            emit(id=host.alias, state="unknown", alert=trouble, metrics={})
        time.sleep(RETRY if trouble else 3)


def watch_forever(aliases):
    """A surprise in here must not leave a machine looking as it last did."""
    while True:
        try:
            watch(Host(aliases))
        except Exception as exc:  # noqa: BLE001 - the edge of the thread: nothing above it would say
            emit(id=aliases[0], name=aliases[0], group="computers", state="unknown", alert=f"ssh source: {exc}", metrics={})
            time.sleep(RETRY)


def main():
    if len(sys.argv) == 3 and sys.argv[1] == "--wake":
        try:
            wake(sys.argv[2])
        except (ValueError, OSError) as exc:
            sys.exit(str(exc))
        return
    try:
        os.setpgid(0, 0)
    except OSError:
        pass
    signal.signal(signal.SIGTERM, lambda *_: os._exit(0))
    os.makedirs(os.path.expanduser("~/.cache/hypertop"), mode=0o700, exist_ok=True)

    def when_stdin_closes():
        sys.stdin.buffer.read()
        leave()

    threading.Thread(target=when_stdin_closes, daemon=True).start()
    skip = read_skip()
    for aliases in read_hosts(CONFIG):
        if set(aliases) & skip:
            continue
        threading.Thread(target=watch_forever, args=(aliases,), daemon=True).start()
    threading.Event().wait()


if __name__ == "__main__":
    main()
