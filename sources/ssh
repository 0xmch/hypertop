# Below normal priority: this must never take time from a game or from audio.
# It ends when the sshd serving it does, which is at once when the connection goes.
# Nothing else tells it: .NET's console streams ignore a closed pipe, and stdin never
# reports its end while cmd.exe holds it too.
WINDOWS_SAMPLER = r"""
$ErrorActionPreference='Stop'
(Get-Process -Id $PID).PriorityClass='BelowNormal'
$a=$PID;$s=$PID
while($a){$q=Get-CimInstance Win32_Process -Filter "ProcessId=$a";if(-not $q){break};if($q.Name -like 'sshd*'){$s=$a;break};$a=$q.ParentProcessId}
$nv=Get-Command nvidia-smi -ErrorAction SilentlyContinue
while(Get-Process -Id $s -ErrorAction SilentlyContinue){
$c=(Get-CimInstance Win32_Processor|Measure-Object LoadPercentage -Average).Average
$o=Get-CimInstance Win32_OperatingSystem
$m=[int](100-100*$o.FreePhysicalMemory/$o.TotalVisibleMemorySize)
$d=Get-CimInstance Win32_LogicalDisk -Filter "DeviceID='C:'"
$p=[int](100-100*$d.FreeSpace/$d.Size)
$u=[int]((Get-Date)-$o.LastBootUpTime).TotalSeconds
$g='';$t=''
if($nv){$r=(& nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits|Select-Object -First 1) -split ',';$g=$r[0].Trim();$t=$r[1].Trim()}
